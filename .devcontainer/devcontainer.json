{
  // محیط آماده VS Code (Dev Container) برای اجرای سیستم فردای روشن
  // در VS Code:  Ctrl+Shift+P  →  Dev Containers: Reopen in Container
  "name": "Farday Roshan (PHP + MariaDB)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "سیستم فردای روشن",
      "onAutoForward": "openBrowser",
      "elevateIfNeeded": false
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "xdebug.php-debug",
        "cweijan.vscode-mysql-client2"
      ],
      "settings": {
        "remote.autoForwardPorts": true,
        "files.encoding": "utf8"
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start-services.sh",
  "remoteUser": "vscode"
}
